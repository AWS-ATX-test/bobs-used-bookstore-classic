    <PackageReference Include="Microsoft.AspNetCore.Owin" Version="6.0.29"></PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.4.0"></PackageReference>
    <PackageReference Include="System.ValueTuple" Version="4.5.0"></PackageReference>
    <PackageReference Include="System.Text.Encoding" Version="4.3.0"></PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0"></PackageReference>
    <PackageReference Include="jQuery.Validation" Version="1.19.5"></PackageReference>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0"></PackageReference>
    <PackageReference Include="System.Memory" Version="4.5.5"></PackageReference>
    <PackageReference Include="Microsoft.jQuery.Unobtrusive.Validation" Version="4.0.0"></PackageReference>
    <PackageReference Include="Modernizr" Version="2.8.3"></PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"></PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.4"></PackageReference>
    <PackageReference Include="Microsoft.Owin.Security.OpenIdConnect" Version="4.2.2"></PackageReference>
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0"></PackageReference>
    <PackageReference Include="EntityFramework" Version="6.5.1"></PackageReference>
    <PackageReference Include="AWSSDK.Core" Version="3.7.400.59"></PackageReference>
