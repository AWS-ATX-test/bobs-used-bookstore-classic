<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <OutputType>Library</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Global.asax.cs"></Compile>
    <Compile Remove="Properties/AssemblyInfo.cs"></Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Exclude="bin\**;obj\**;Properties\AssemblyInfo.cs" Include="**\*.cs"></Compile>
  </ItemGroup>
  <ItemGroup>
    <None Condition="'Library' == 'Exe'" Include="App.config"></None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\"></Folder>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autofac.Owin" Version="*"></PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.2.0"></PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Owin" Version="8.0.23"></PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.24"></PackageReference>
    <PackageReference Include="jQuery.Validation" Version="1.19.5"></PackageReference>
    <PackageReference Include="Microsoft.jQuery.Unobtrusive.Validation" Version="4.0.0"></PackageReference>
    <PackageReference Include="Microsoft.Owin.Security.OpenIdConnect" Version="4.2.2"></PackageReference>
    <PackageReference Include="Modernizr" Version="2.8.3"></PackageReference>
    <PackageReference Include="System.Text.Encoding" Version="4.3.0"></PackageReference>
    <PackageReference Include="AWSSDK.Core" Version="4.0.3.11"></PackageReference>
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.3.13"></PackageReference>
    <PackageReference Include="AWSSDK.S3" Version="4.0.18.2"></PackageReference>
    <PackageReference Include="EntityFramework" Version="6.5.1"></PackageReference>
    <PackageReference Include="Autofac" Version="8.4.0"></PackageReference>
    <PackageReference Include="AWS.Logger.Core" Version="4.0.1"></PackageReference>
    <PackageReference Include="AWS.Logger.NLog" Version="5.0.0"></PackageReference>
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.14.5"></PackageReference>
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.6.11"></PackageReference>
    <PackageReference Include="jQuery" Version="3.7.0"></PackageReference>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.9"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.14.0"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.14.0"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.14.0"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.15.0"></PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0"></PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5"></PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"></PackageReference>
    <PackageReference Include="NLog" Version="6.0.5"></PackageReference>
    <PackageReference Include="System.Buffers" Version="4.6.1"></PackageReference>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.9"></PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0"></PackageReference>
    <PackageReference Include="System.Memory" Version="4.6.3"></PackageReference>
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1"></PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2"></PackageReference>
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.10"></PackageReference>
    <PackageReference Include="System.Text.Json" Version="9.0.9"></PackageReference>
